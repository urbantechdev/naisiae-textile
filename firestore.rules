rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. HELPERS
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        request.auth.token.email == 'support@naisiaetextile.com'
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 2. PUBLIC READ ACCESS
    match /settings/{id} { allow read: if true; }
    match /products/{id} { allow read: if true; }
    match /promotions/{id} { allow read: if true; }
    match /discountRules/{id} { allow read: if true; }
    match /mega_menus/{id} { allow read: if true; }
    match /categories/{id} { allow read: if true; }
    match /services/{id} { allow read: if true; }
    match /portfolio/{id} { allow read: if true; }
    match /reviews/{id} { allow read: if true; }
    match /system/{id} { allow read: if true; }
    match /test/connection { allow read: if true; }

    // 3. PUBLIC WRITE ACCESS (Gated by specific fields if needed)
    match /analytics/{id} {
      allow write: if true; // Public can record views
      allow read: if isAdmin();
    }
    match /quotes/{id} {
      allow create: if isValidId(id);
      allow read, update, delete: if isAdmin();
    }
    match /reviews/{id} {
      allow create: if isValidId(id) && incoming().status == 'pending';
      allow update, delete: if isAdmin();
    }

    // 4. SECURE USER DATA
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 5. GLOBAL DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
