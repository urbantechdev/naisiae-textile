rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        request.auth.token.email == 'support@naisiaetextile.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public collections
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /mega_menus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /portfolio/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /quotes/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /system/{id} {
      allow read: if true;
    }

    match /analytics/{id} {
      allow read, write: if true;
    }

    match /admins/{userId} {
      allow read, write: if isAdmin();
    }
    
    match /discountRules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
