rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        request.auth.token.email == 'support@naisiaetextile.com'
      );
    }

    // Special permissive rule for the main developer to unblock them
    match /{document=**} {
      allow read, write: if isSignedIn() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        request.auth.token.email == 'support@naisiaetextile.com'
      );
    }

    // Public Collections
    match /settings/{id} {
      allow get: if true;
      allow list, write: if isAuthAdmin();
    }

    match /products/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }
    
    match /categories/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /mega_menus/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /promotions/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /services/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /portfolio/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /reviews/{id} {
      allow get: if true;
      allow list: if resource.data.get('status', 'pending') == 'approved' || isAuthAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAuthAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /discountRules/{id} {
      allow get, list: if true;
      allow write: if isAuthAdmin();
    }

    match /system/{id} {
      allow read: if true;
    }

    // User Data
    match /users/{userId} {
      allow read, write: if isAuthAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /wishlists/{userId} {
      allow read, write: if isAuthAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAuthAdmin();
    }

    // Others
    match /quotes/{id} {
      allow create: if true;
      allow read, write: if isAuthAdmin();
    }

    match /analytics/{id} {
      allow create: if true;
      allow read, write: if isAuthAdmin();
    }
    
    match /analytics/{dayId}/events/{eventId} {
      allow create: if true;
      allow read, write: if isAuthAdmin();
    }
  }
}
