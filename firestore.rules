rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // 1. GLOBAL HELPERS & SAFETY
    // ---------------------------------------------------------
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // ---------------------------------------------------------
    // 2. COLLECTION RULES
    // ---------------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
      
      // Validation for creation
      function isValidProduct(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
               data.price is number && data.price >= 0;
      }
      
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // Users can only write their own profile, but can't self-elevate to admin
      allow write: if isSignedIn() && request.auth.uid == userId && (
        incoming().role == 'user' || (existing() != null && incoming().role == existing().role)
      ) || isAdmin();
    }

    match /quotes/{quoteId} {
      allow create: if isValidId(quoteId) && 
                      incoming().customerName is string && incoming().customerName.size() <= 100 &&
                      incoming().email is string && incoming().email.size() <= 100 &&
                      incoming().phone is string && incoming().phone.size() <= 20 &&
                      incoming().status == 'pending';
      
      allow read, update, delete: if isAdmin();
    }

    match /wishlists/{wishlistId} {
      allow read, write: if isSignedIn() && request.auth.uid == wishlistId;
      allow read: if isAdmin();
    }

    match /analytics/{allPaths=**} {
      allow create, update: if true; // Analytics can be generated by public actions
      allow read: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(promoId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    match /discountRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(ruleId);
    }

    match /mega_menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(menuId);
    }

    match /system/connection-test {
      allow read: if true;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      
      // Strict creation for reviews
      allow create: if isValidId(reviewId) && 
                      incoming().status == 'pending' &&
                      incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
                      incoming().text is string && incoming().text.size() <= 1000;
                      
      allow update, delete: if isAdmin();
    }
  }
}
