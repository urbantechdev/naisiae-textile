{
  "entities": {
    "product": {
      "title": "Product",
      "description": "An item sold on the platform.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "oldPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "badge": { "type": "string" },
        "tags": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "color": { "type": "string" },
        "stroke": { "type": "string" },
        "sortOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price"]
    },
    "user": {
      "title": "User",
      "description": "A system user or administrator.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "quote": {
      "title": "Quote Request",
      "description": "User request for a custom quote.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "institution": { "type": "string" },
        "service": { "type": "string" },
        "quantity": { "type": "number" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "quoted", "closed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "service"]
    },
    "analytic": {
      "title": "Analytic Event",
      "description": "Record of a user action for tracking.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["view", "click", "order"] },
        "target": { "type": "string" },
        "path": { "type": "string" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "promotion": {
      "title": "Promotion",
      "description": "Marketing campaign or promotional banner.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonLink": { "type": "string" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "type": { "type": "string", "enum": ["banner", "top-bar", "modal"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "active", "type"]
    },
    "setting": {
      "title": "Site Settings",
      "description": "Global configuration for site branding and metadata.",
      "type": "object",
      "properties": {
        "siteLogo": { "type": "string" },
        "footerLogo": { "type": "string" },
        "favicon": { "type": "string" },
        "siteTagline": { "type": "string" },
        "sharingTitle": { "type": "string" },
        "sharingDescription": { "type": "string" },
        "sharingImage": { "type": "string" },
        "enableComparison": { "type": "boolean" },
        "enableReviews": { "type": "boolean" },
        "heroImages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string" },
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "link": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "discountRule": {
      "title": "Discount Rule",
      "description": "Automatic discount thresholds for bulk orders.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["quantity", "total"] },
        "threshold": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "threshold", "discountPercentage", "active"]
    },
    "review": {
      "title": "Product Review",
      "description": "User feedback and rating for a product.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "rating", "comment", "status"]
    },
    "mega_menu": {
      "title": "Mega Menu",
      "description": "Advanced navigation menu structure with featured content and nested categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "featured": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "image": { "type": "string" },
            "link": { "type": "string" }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "featured", "categories"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Store for site-wide configuration."
    },
    "/products/{productId}": {
      "schema": "product",
      "description": "Collection of all items for sale."
    },
    "/mega_menus/{menuId}": {
      "schema": "mega_menu",
      "description": "Advanced navigation menu structures."
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "User account data and roles."
    },
    "/quotes/{quoteId}": {
      "schema": "quote",
      "description": "Incoming quote requests from the website form."
    },
    "/analytics/{dayId}/events/{eventId}": {
      "schema": "analytic",
      "description": "Timed events for dashboard analytics."
    },
    "/promotions/{promoId}": {
      "schema": "promotion",
      "description": "Marketing promotions and announcements."
    },
    "/discountRules/{ruleId}": {
      "schema": "discountRule",
      "description": "Rules for automated bulk order discounts."
    },
    "/reviews/{reviewId}": {
      "schema": "review",
      "description": "Product reviews moderated by admins."
    },
    "/system/{docId}": {
      "schema": {
        "title": "System Document",
        "description": "Misc system documents for health checks.",
        "type": "object",
        "properties": {
          "status": { "type": "string" }
        }
      },
      "description": "System health and configuration checks."
    }
  }
}
