rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- Collections ---

    // Products: Anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description', 'price', 'oldPrice', 'imageUrl', 'badge', 'tag', 'color', 'stroke', 'sortOrder', 'active', 'updatedAt']);
      allow delete: if isAdmin();
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.category is string && data.category.size() > 0 &&
             data.price is number && data.price >= 0;
    }

    // Users: Users can read/write their own profile, only admin can list or change roles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && 
                    incoming().role == 'user'; // Prevent self-assigning admin
      allow update: if isSignedIn() && request.auth.uid == userId && 
                    !incoming().diff(existing()).affectedKeys().hasAny(['role']) &&
                    isValidUser(incoming());
      allow update: if isAdmin(); // Admin can change anything (including roles)
    }

    function isValidUser(data) {
      return data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'user'];
    }

    // Quotes: Anyone can create, only admin can read/list/delete
    match /quotes/{quoteId} {
      allow create: if isSignedIn() && isValidQuote(incoming()) && isValidId(quoteId);
      allow get: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    function isValidQuote(data) {
      return data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() > 0 &&
             data.service is string && data.service.size() > 0;
    }

    // Analytics: Strictly additions
    match /analytics/{dayId}/events/{eventId} {
      allow create: if true; // Open creation for tracking
      allow read: if isAdmin();
    }
  }
}
